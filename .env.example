# Zikra — environment template
# Copy to .env and fill in. NEVER commit the real .env (it is gitignored).
# Each machine runs its own local Zikra instance / DB for dev; values below are
# per-machine UNLESS marked [SHARED].
#
# ─────────────────────────────────────────────────────────────────────────────
# Server identity & auth
# ─────────────────────────────────────────────────────────────────────────────
# Bearer token clients must send (Authorization: Bearer <token>) to THIS Zikra
# server. Generate a random value per instance, e.g.  python -c "import secrets;print(secrets.token_urlsafe(32))"
ZIKRA_TOKEN=change-me-generate-a-random-token
ZIKRA_HOST=0.0.0.0          # bind address for the FastAPI/MCP server
ZIKRA_PORT=8000             # server port (MCP mounted at /mcp)
ZIKRA_PROJECT=main          # default project namespace for this instance
ZIKRA_PROFILE=webhook       # server profile (e.g. webhook | stdio)
ZIKRA_URL=http://localhost:8000   # base URL clients use to reach this instance
ZIKRA_SKIP_ONBOARDING=0     # set 1 to skip first-run onboarding

# ─────────────────────────────────────────────────────────────────────────────
# Database  (local per-machine — never sync DB data between machines)
# ─────────────────────────────────────────────────────────────────────────────
DB_BACKEND=sqlite           # sqlite (default) | postgres
ZIKRA_DB_PATH=./zikra.db    # SQLite file path (used when DB_BACKEND=sqlite)
# Postgres backend (only when DB_BACKEND=postgres):
DB_HOST=localhost
DB_PORT=5432
DB_NAME=zikra
DB_USER=zikra
DB_PASSWORD=change-me

# ─────────────────────────────────────────────────────────────────────────────
# Embeddings / LLM  (optional — for semantic memory search)
# ─────────────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=             # leave empty to disable embeddings, or set a key
OPENAI_API_BASE=            # override for a self-hosted/LiteLLM proxy, e.g. http://localhost:4000
ZIKRA_EMBEDDING_MODEL=text-embedding-3-small

# ─────────────────────────────────────────────────────────────────────────────
# Memory scoring / decay tuning  (optional — sensible defaults in code)
# ─────────────────────────────────────────────────────────────────────────────
ZIKRA_DECAY_DAYS=30
ZIKRA_FREQUENCY_WEIGHT=1.0
DEFAULT_PROJECT=main

# ─────────────────────────────────────────────────────────────────────────────
# docker-compose stack (local dev: Postgres + LiteLLM + n8n) — all per-machine
# ─────────────────────────────────────────────────────────────────────────────
POSTGRES_DB=zikra
POSTGRES_USER=zikra
POSTGRES_PASSWORD=change-me
LITELLM_MASTER_KEY=sk-change-me
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me
N8N_ENCRYPTION_KEY=change-me-32-char-random
WEBHOOK_URL=http://localhost:5678

# Note: COMPUTERNAME / HOSTNAME are read from the OS automatically — do not set here.
