# Copy to container-secrets.local and replace both placeholders.
# The destination file is ignored by Git and should use mode 0600.
POSTGRES_PASSWORD=replace-with-a-random-password
ZIKRA_TOKEN=replace-with-a-developer-token

# Optional local embedding overrides:
# EMBEDDING_API_BASE=http://host.docker.internal:1234/v1
# EMBEDDING_API_KEY=local-development
# EMBEDDING_UPSTREAM_MODEL=google/embedding-gemma-300m
# ZIKRA_EMBEDDING_MODEL=local-embedding
# ZIKRA_EMBEDDING_DIMENSIONS=768
